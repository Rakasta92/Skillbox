#include <iostream>

int main() {
  std::string word;
  bool inWord = false;
  int wordCount = 0;
  
  std::cout << "====Task 3.Counting the number of words====\n";
  std::cout << "Input your string: ";
  std::getline(std::cin, word);

  if (word.length() > 100) {
    std::cout << "Error! Your string is too long!" << std::endl;
    return 1;
  }
 
  for (int i = 0; i < word.length(); i++) {
    if (word[i] == ' ') {
      inWord = false;   // пробел – выходим из слова
    } else {
      if (!inWord) {    // перешли из пробела в непробел – начало нового слова
        wordCount++;
        inWord = true;
      }
    }
  }
  
  std::cout << "Answer: " << wordCount << std::endl;    

  return 0;
}
